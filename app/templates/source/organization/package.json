{
  "name": "Organization",
  "locals": {
    "page_size": 12,
    "hide_dates": false,
    "date_display": "MMMM D, Y",
    "background_color": "#ffffff",
    "text_color": "#212529",
    "accent_color": "#03a87c",
    "tag_color": "#ea2f65",
    "surface_color": "#e8f3ec",
    "font": {
      "id": "system-sans",
      "font_size": 16,
      "line_height": 1.6
    },
    "heading_font": {
      "id": "georgia"
    },
    "article_font": {
      "id": "source-serif",
      "font_size": 20,
      "line_height": 1.86
    },
    "logo_url": "",
    "favicon_url": "",
    "sticky_navigation": true,
    "footer_navigation": true,
    "show_search": true,
    "show_featured": true,
    "drop_cap": true
  },
  "isPublic": false,
  "views": {
    "error": {
      "partials": {
        "title": "{{{error.title}}} - {{{title}}}",
        "description": "Error on {{{title}}}"
      }
    },
    "public": {
      "partials": {
        "title": "Index of {{{path}}}",
        "description": "All the files and folders inside {{{path}}}"
      }
    },
    "script": {
      "url": "/script.js"
    },
    "sitemap": {
      "url": "/sitemap.xml"
    },
    "feed": {
      "url": "/feed.rss"
    },
    "robots": {
      "url": "/robots.txt"
    },
    "archives.html": {
      "url": "/archives",
      "partials": {
        "title": "Archives - {{{title}}}",
        "description": "All the entries posted on {{{title}}}"
      }
    },
    "tagged.html": {
      "partials": {
        "title": "Entries tagged {{{tag}}} from {{{title}}}",
        "description": "All of the entries posted on {{{title}}} tagged {{{tag}}}"
      }
    },
    "entries.html": {
      "partials": {
        "title": "{{{title}}}",
        "description": "The latest entries posted on {{{title}}}"
      }
    },
    "entry.html": {
      "partials": {
        "title": "{{{entry.title}}} - {{{title}}}",
        "description": "{{{entry.summary}}}"
      }
    },
    "search.html": {
      "partials": {
        "title": "Search - {{{title}}}",
        "description": "Search all the entries posted on {{{title}}}"
      }
    }
  }
}
