[DEFAULT]
backend = polling
banaction = iptables-multiport
bantime  = 3600
findtime = 600
maxretry = 3
# Cloudflare's edge IP ranges. Defense-in-depth alongside the real_ip fix in
# config/openresty/conf/cloudflare-real-ip.conf: that fix makes fail2ban see
# each visitor's real IP for Cloudflare-proxied traffic, so this list should
# rarely matter in practice, but it prevents ever banning a shared edge
# address outright if real_ip restoration fails for any reason. Ranges from
# https://www.cloudflare.com/ips-v4 and /ips-v6 (checked 2026-09-12).
ignoreip = 127.0.0.1/8 ::1
           103.21.244.0/22
           103.22.200.0/22
           103.31.4.0/22
           104.16.0.0/13
           104.24.0.0/14
           108.162.192.0/18
           131.0.72.0/22
           141.101.64.0/18
           162.158.0.0/15
           172.64.0.0/13
           173.245.48.0/20
           188.114.96.0/20
           190.93.240.0/20
           197.234.240.0/22
           198.41.128.0/17
           2400:cb00::/32
           2606:4700::/32
           2803:f800::/32
           2405:b500::/32
           2405:8100::/32
           2a06:98c0::/29
           2c0f:f248::/32

bantime.increment = true
bantime.factor = 24
bantime.formula = ban.Time * (1<<(ban.Count-1))
bantime.maxtime = 604800

[nginx-403]
filter = nginx-403
enabled = true
logpath = /var/instance-ssd/logs/access.log
backend = polling
port = http,https
maxretry = 15
bantime = 1800
banaction = iptables-multiport
logencoding = auto
polling_file = true
findtime = 30
maxlines = 100

[nginx-404]
enabled = true
logpath = /var/instance-ssd/logs/access.log
backend = polling
port = http,https
maxretry = 80
bantime = 1800
banaction = iptables-multiport
logencoding = auto
polling_file = true
findtime = 30
maxlines = 100

[nginx-429]
enabled = true
logpath = /var/instance-ssd/logs/access.log
backend = polling
port = http,https
maxretry = 10 
bantime = 1800
banaction = iptables-multiport
logencoding = auto
polling_file = true
findtime = 30
maxlines = 100

[nginx-444]
filter = nginx-444
enabled = true
logpath = /var/instance-ssd/logs/access.log
backend = polling
port = http,https
maxretry = 3
findtime = 120
bantime = 3600
banaction = iptables-multiport
logencoding = auto
polling_file = true
maxlines = 100